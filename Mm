def check_gmail_availability(email):
    # دالة فحص جيميل المتقدمة (تستخدم لمحاكاة التحقق من الوجود)
    url = "https://mail.google.com/mail/gxlu"
    headers = {
        "User-Agent": generate_user_agent(),
        "Accept": "*/*",
    }
    try:
        r = requests.get(url, params={"email": email}, headers=headers, timeout=7)
        # في جيميل، وجود الكوكيز 'COMPASS' قد يشير إلى حالة الحساب
        if 'COMPASS' in r.cookies:
            return False # البريد مستخدم
        return True # البريد قد يكون متاحاً
    except:
        return None

def check_hotmail_availability(email):
    # دالة فحص هوتميل الكاملة باستخدام GetCredentialType
    url = "https://login.live.com/GetCredentialType.srf"
    ua = generate_user_agent()
    headers = {
        "User-Agent": ua,
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Referer": "https://login.live.com/",
    }
    data = {
        "username": email,
        "isOtherIdpSupported": True,
        "checkRemoteWP": True,
        "isRemoteWpSupported": True,
        "checkRemoteWpEnterprise": True,
        "isRemoteWpEnterpriseSupported": True,
        "isOTPSupported": True
    }
    try:
        r = requests.post(url, json=data, headers=headers, timeout=7)
        if '"IfExistsResult":1' in r.text:
            return False # Taken
        elif '"IfExistsResult":5' in r.text:
            return True # Available
        return False
    except:
        return None

def check_hi2in_availability(email):
    # دالة فحص hi2.in مع حل الكابتشا كما في كودك الأصلي تماماً
    if "@" not in email: return False
    prefix, domain = email.split("@")
    try:
        # ReCaptcha Solver Logic
        anchor_url = "https://www.google.com/recaptcha/api2/anchor?ar=1&k=6LfEUPkgAAAAAKTgbMoewQkWBEQhO2VPL4QviKct&co=aHR0cHM6Ly9oaTIuaW46NDQz&hl=en&v=XrIDux0s7SoNe6_IHkjGC92W&size=invisible"
        params = anchor_url.split('?')[1]
        r_anchor = requests.get(f'https://www.google.com/recaptcha/enterprise/anchor?{params}', timeout=10)
        rec_token = r_anchor.text.split('recaptcha-token" value="')[1].split('"')[0]
        
        payload = f"v={params.split('v=')[1].split('&')[0]}&reason=q&c={rec_token}&k=6LfEUPkgAAAAAKTgbMoewQkWBEQhO2VPL4QviKct&co=aHR0cHM6Ly9oaTIuaW46NDQz&hl=en&size=invisible"
        headers_rec = {
            "User-Agent": generate_user_agent(),
            "Referer": f"https://www.google.com/recaptcha/enterprise/anchor?{params}",
            "Content-Type": "application/x-www-form-urlencoded"
        }
        r_reload = requests.post('https://www.google.com/recaptcha/enterprise/reload', data=payload, headers=headers_rec)
        solve = r_reload.text.split('resp","')[1].split('"')[0]
        
        # Final API Check
        data_api = {'domain': domain, 'prefix': prefix, 'recaptcha': solve}
        headers_api = {
            'User-Agent': generate_user_agent(),
            'Accept': "application/json, text/plain, */*",
            'authorization': "Basic bnVsbA=="
        }
        response = requests.post("https://hi2.in/api/custom", data=data_api, headers=headers_api)
        if "already taken" in response.text:
            return False
        return True
    except:
        return False

