def check_tiktok_logic(email):
    # دالة فحص تيك توك الاحترافية (محاكاة طلبات التطبيق)
    url = "https://www.tiktok.com/api/v2/shop/email/check/"
    headers = {
        "Host": "www.tiktok.com",
        "Connection": "keep-alive",
        "Accept": "application/json, text/plain, */*",
        "User-Agent": generate_user_agent(),
        "X-Requested-With": "XMLHttpRequest",
        "Sec-Fetch-Site": "same-origin",
        "Sec-Fetch-Mode": "cors",
        "Sec-Fetch-Dest": "empty",
        "Referer": "https://www.tiktok.com/signup/email",
        "Accept-Encoding": "gzip, deflate, br",
        "Accept-Language": "en-US,en;q=0.9"
    }
    try:
        # فحص الربط عبر API التسجيل الداخلي
        r = requests.get(url, params={"email": email, "aid": "1988"}, headers=headers, timeout=10)
        if r.status_code == 429: return "RATE_LIMIT"
        res_json = r.json()
        # المنطق: إذا كان is_registered هو True أو كان الكود يشير لوجود الحساب
        if res_json.get("is_registered") == True or res_json.get("error_code") == 1001:
            return True
        return False
    except:
        return "ERROR"

def check_binance_logic(email):
    # دالة فحص باينانس (التحقق من وجود الحساب)
    url = "https://www.binance.com/bapi/accounts/v1/public/account/check-email"
    headers = {
        "Content-Type": "application/json",
        "User-Agent": generate_user_agent(),
        "client-type": "web",
        "lang": "en",
        "Origin": "https://www.binance.com",
        "Referer": "https://www.binance.com/en/login",
        "CSRF-Token": secrets.token_hex(16)
    }
    payload = {
        "email": email,
        "fast": True,
        "bizType": "login"
    }
    try:
        r = requests.post(url, json=payload, headers=headers, timeout=10)
        if r.status_code == 429: return "RATE_LIMIT"
        data = r.json()
        if data.get("data") == True or data.get("success") == True:
            return True
        return False
    except:
        return "ERROR"

def check_facebook_logic(email):
    # فحص فيسبوك (طريقة محاكاة البحث عن الحساب لاستعادة كلمة المرور)
    url = "https://m.facebook.com/login/identify/?ctx=recover&c=https%3A%2F%2Fm.facebook.com%2F&multiple_results=0&ars=facebook_login&from_login_screen=0&lwv=100&_rdr"
    headers = {
        "Authority": "m.facebook.com",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Cache-Control": "max-age=0",
        "Origin": "https://m.facebook.com",
        "Referer": "https://m.facebook.com/",
        "User-Agent": generate_user_agent()
    }
    try:
        # طلب مبدئي لسحب الكوكيز
        s = requests.Session()
        res_init = s.get(url, headers=headers, timeout=10)
        soup = BeautifulSoup(res_init.text, 'html.parser')
        lsd = soup.find('input', {'name': 'lsd'})['value']
        jazoest = soup.find('input', {'name': 'jazoest'})['value']
        
        post_data = {
            "lsd": lsd,
            "jazoest": jazoest,
            "email": email,
            "did_submit": "Search"
        }
        r_check = s.post("https://m.facebook.com/login/identify/?ctx=recover", data=post_data, headers=headers, timeout=10)
        
        # إذا تم تحويلك لصفحة اختيار طريقة الاستعادة، فهذا يعني أن الحساب موجود
        if "recover/code" in r_check.url or "checkpoint" in r_check.url or "send_email" in r_check.text:
            return True
        return False
    except:
        return "ERROR"

